+    if constexpr (smem_grid && type == GGML_TYPE_IQ3_S) {
+        return vec_dot_iq3_s_q8_1_g(vx, y, kbx, kqs, reinterpret_cast<const uint32_t *>(g));
+    } else if constexpr (smem_grid && type == GGML_TYPE_IQ3_XXS) {
+        return vec_dot_iq3_xxs_q8_1_g(vx, y, kbx, kqs, reinterpret_cast<const uint32_t *>(g));

+#pragma once
+// Tesla V100 (sm_70) tuning for the MMVQ decode / speculative-verify GEMV.
+// The 3-bit/2-bit i-quants are limited by their codebook lookups on Volta (~30-40% of DRAM bandwidth with the stock
+// kernel), so their codebook is staged in shared memory and each block works on several rows, which shares the
+// staging cost and gives wider, coalesced weight reads. Values in mmvq-v100-params.h were measured with
+// test-backend-ops perf at the Qwen3.8-27B ffn shapes.
+
+#include "ggml.h"
+#include "mmvq-v100-params.h"
+
+static constexpr __host__ __device__ bool v100_is_iq3(ggml_type type) {
+    return type == GGML_TYPE_IQ3_S || type == GGML_TYPE_IQ3_XXS;
+}
+static constexpr __host__ __device__ bool v100_is_iq2(ggml_type type) {
+    return type == GGML_TYPE_IQ2_S || type == GGML_TYPE_IQ2_XS || type == GGML_TYPE_IQ2_XXS;
+}
+
+// rows per CUDA block, by type and number of tokens (dst columns); 0 = keep the Turing default
+static constexpr __host__ __device__ int v100_rows_per_block(ggml_type type, int ncols_dst) {
+    return v100_is_iq3(type) ? (ncols_dst == 1 ? V100_RPB_IQ3_N1 : (ncols_dst <= 4 ? V100_RPB_IQ3_N4 : V100_RPB_IQ3_N8))
+         : v100_is_iq2(type) ? (ncols_dst == 1 ? V100_RPB_IQ2_N1 : (ncols_dst <= 4 ? V100_RPB_IQ2_N4 : V100_RPB_IQ2_N8))
+         : type == GGML_TYPE_Q3_K ? (ncols_dst == 1 ? V100_RPB_Q3K_N1 : (ncols_dst <= 4 ? V100_RPB_Q3K_N4 : V100_RPB_Q3K_N8))
+         : 0;
+}
+
+// warps per CUDA block; 0 = keep the Turing default
+static constexpr __host__ __device__ int v100_nwarps(ggml_type type, int ncols_dst) {
+    return v100_is_iq3(type) ? (ncols_dst == 1 ? V100_NW_IQ3_N1 : (ncols_dst <= 4 ? V100_NW_IQ3_N4 : V100_NW_IQ3_N8))
+         : v100_is_iq2(type) ? (ncols_dst == 1 ? V100_NW_IQ2_N1 : (ncols_dst <= 4 ? V100_NW_IQ2_N4 : V100_NW_IQ2_N8))
+         : type == GGML_TYPE_Q3_K ? (ncols_dst == 1 ? V100_NW_Q3K_N1 : (ncols_dst <= 4 ? V100_NW_Q3K_N4 : V100_NW_Q3K_N8))
+         : 0;
+}
+
+// stage the codebook of these types in shared memory
+static constexpr __host__ __device__ bool v100_smem_grid(ggml_type type) {
+    return (V100_SMEM_GRID && v100_is_iq3(type)) || (V100_SMEM_GRID_IQ2 && v100_is_iq2(type));
+}
+
+// codebook entries (uint32 for IQ3, uint64 for IQ2)
+static constexpr __host__ __device__ int v100_grid_n(ggml_type type) {
+    return type == GGML_TYPE_IQ3_S ? 512 : type == GGML_TYPE_IQ3_XXS ? 256 :
+           type == GGML_TYPE_IQ2_S ? 1024 : type == GGML_TYPE_IQ2_XS ? 512 : type == GGML_TYPE_IQ2_XXS ? 256 : 1;
+}

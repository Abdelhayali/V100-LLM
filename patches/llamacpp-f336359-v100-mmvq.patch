+// Decode-once helpers for multi-token GEMV (speculative verify): unpack one IQ3 weight block into 8 signed int8x4 words,
+// then dot it with any number of q8_1 columns. Same integer/float operation order as vec_dot_iq3_*_q8_1.
+struct iq3_dec {
+    int   g[8];   // signed codebook values, 4 x int8 each
+    int   sc;     // IQ3_S: integer block scale; IQ3_XXS: 4-bit ls
+    float d;      // fp16 block scale as float
+};
+
+static __device__ __forceinline__ iq3_dec decode_iq3_s(const void * __restrict__ vbq, const int & kbx, const int & iqs,
+                                                       const uint32_t * __restrict__ grid) {
+    const block_iq3_s * bq3 = (const block_iq3_s *) vbq + kbx;
+    const int2      qs_packed = make_int2(get_int_b2(bq3->qs, iqs + 0), get_int_b2(bq3->qs, iqs + 1));
+    const uint8_t * qs        = (const uint8_t *) &qs_packed;
+    const int qh = bq3->qh[iqs/2];
+    const int       signs_packed_32 = get_int_b2(bq3->signs, iqs/2);
+    const uint8_t * signs_packed_8  = (const uint8_t *) &signs_packed_32;
+    iq3_dec w;
+#pragma unroll
+    for (int l0 = 0; l0 < 8; l0 += 2) {
+        const int2 grid_pos = make_int2(
+            grid[qs[l0 + 0] | ((qh << (8 - l0)) & 0x100)],
+            grid[qs[l0 + 1] | ((qh << (7 - l0)) & 0x100)]);
+        const int signs0 = __vcmpne4(((signs_packed_8[l0/2] & 0x03) << 7) | ((signs_packed_8[l0/2] & 0x0C) << 21), 0x00000000);
+        const int signs1 = __vcmpne4(((signs_packed_8[l0/2] & 0x30) << 3) | ((signs_packed_8[l0/2] & 0xC0) << 17), 0x00000000);
+        w.g[l0 + 0] = __vsub4(grid_pos.x ^ signs0, signs0);
+        w.g[l0 + 1] = __vsub4(grid_pos.y ^ signs1, signs1);
+    }
+    w.sc = 1 + 2*((bq3->scales[iqs/4] >> ((iqs << 1) & 0x04)) & 0x0F);
+    w.d  = __half2float(bq3->d);
+    return w;
+}
+
+static __device__ __forceinline__ float dot_iq3_s_dec(const iq3_dec & w, const block_q8_1 * __restrict__ bq8_1, const int & iqs) {
+    int sumi = 0;
+#pragma unroll
+    for (int l = 0; l < 8; ++l) {
+        sumi = ggml_cuda_dp4a(w.g[l], get_int_b4(bq8_1[iqs/2].qs, l), sumi);
+    }
+    sumi *= w.sc;
+    const float d = w.d * __low2float(bq8_1[iqs/2].ds);
+    return d * sumi;
+}
+
+static __device__ __forceinline__ iq3_dec decode_iq3_xxs(const void * __restrict__ vbq, const int & kbx, const int & iqs,
+                                                         const uint32_t * __restrict__ grid) {
+    const block_iq3_xxs * bq3 = (const block_iq3_xxs *) vbq + kbx;
+    const int2 q3_packed = make_int2(get_int_b2(bq3->qs, iqs), get_int_b2(bq3->qs, iqs+1));
+    const uint8_t * q3 = (const uint8_t *) &q3_packed;
+    const uint32_t aux32 = get_int_b2(bq3->qs, QK_K/16 + iqs/2);
+    iq3_dec w;
+#pragma unroll
+    for (int l0 = 0; l0 < 8; l0 += 2) {
+        const int2 grid_pos = make_int2(grid[q3[l0 + 0]], grid[q3[l0 + 1]]);
+        const uint32_t signs = unpack_ksigns(aux32 >> (7*l0/2));
+        const int signs0 = __vcmpne4(signs & 0x08040201, 0);
+        const int signs1 = __vcmpne4(signs & 0x80402010, 0);
+        w.g[l0 + 0] = __vsub4(grid_pos.x ^ signs0, signs0);
+        w.g[l0 + 1] = __vsub4(grid_pos.y ^ signs1, signs1);
+    }
+    w.sc = aux32 >> 28;
+    w.d  = __half2float(bq3->d);
+    return w;
+}
+
+static __device__ __forceinline__ float dot_iq3_xxs_dec(const iq3_dec & w, const block_q8_1 * __restrict__ bq8_1, const int & iqs) {
+    int sumi = 0;
+#pragma unroll
+    for (int l = 0; l < 8; ++l) {
+        sumi = ggml_cuda_dp4a(w.g[l], get_int_b4(bq8_1[iqs/2].qs, l), sumi);
+    }
+    sumi = (w.sc*sumi + sumi/2)/2;
+    const float d = w.d * __low2float(bq8_1[iqs/2].ds);
+    return d * sumi;
+}
+
+// same, with the codebook read from `grid` (e.g. staged in shared memory)
+static __device__ __forceinline__ float vec_dot_iq3_s_q8_1_g(
+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs, const uint32_t * __restrict__ grid) {
+
+    const block_iq3_s * bq3 = (const block_iq3_s *) vbq + kbx;
+
+    const int2      qs_packed = make_int2(get_int_b2(bq3->qs, iqs + 0), get_int_b2(bq3->qs, iqs + 1));
+    const uint8_t * qs        = (const uint8_t *) &qs_packed;
+
+    const int qh = bq3->qh[iqs/2];
+
+    const int       signs_packed_32 = get_int_b2(bq3->signs, iqs/2);
+    const uint8_t * signs_packed_8  = (const uint8_t *) &signs_packed_32;
+
+    int sumi = 0;
+#pragma unroll
+    for (int l0 = 0; l0 < 8; l0 += 2) {
+        const int2 grid_pos = make_int2(
+            grid[qs[l0 + 0] | ((qh << (8 - l0)) & 0x100)],
+            grid[qs[l0 + 1] | ((qh << (7 - l0)) & 0x100)]);
+
+        const int signs0 = __vcmpne4(((signs_packed_8[l0/2] & 0x03) << 7) | ((signs_packed_8[l0/2] & 0x0C) << 21), 0x00000000);
+        const int signs1 = __vcmpne4(((signs_packed_8[l0/2] & 0x30) << 3) | ((signs_packed_8[l0/2] & 0xC0) << 17), 0x00000000);
+
+        const int grid_l = __vsub4(grid_pos.x ^ signs0, signs0);
+        const int grid_h = __vsub4(grid_pos.y ^ signs1, signs1);
+
+        const int u0 = get_int_b4(bq8_1[iqs/2].qs, l0 + 0);
+        const int u1 = get_int_b4(bq8_1[iqs/2].qs, l0 + 1);
+
+        sumi = ggml_cuda_dp4a(grid_l, u0, sumi);
+        sumi = ggml_cuda_dp4a(grid_h, u1, sumi);
+    }
+
+    sumi *= 1 + 2*((bq3->scales[iqs/4] >> ((iqs << 1) & 0x04)) & 0x0F);
+
+    const float d = __half2float(bq3->d) * __low2float(bq8_1[iqs/2].ds);
+    return d * sumi;
+}

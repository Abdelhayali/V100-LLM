+        return vec_dot_iq2_s_q8_1_g(vx, y, kbx, kqs, reinterpret_cast<const uint64_t *>(g));
+    } else if constexpr (smem_grid && type == GGML_TYPE_IQ2_XS) {
+        return vec_dot_iq2_xs_q8_1_g(vx, y, kbx, kqs, reinterpret_cast<const uint64_t *>(g));
+    } else if constexpr (smem_grid && type == GGML_TYPE_IQ2_XXS) {
+        return vec_dot_iq2_xxs_q8_1_g(vx, y, kbx, kqs, reinterpret_cast<const uint64_t *>(g));
+    } else {
+        constexpr vec_dot_q_cuda_t vec_dot = get_vec_dot_q_cuda(type);
+        return vec_dot(vx, y, kbx, kqs);
+    }

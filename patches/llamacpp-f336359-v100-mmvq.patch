+static bool ggml_cuda_v100_split_gate(const ggml_tensor * up) {
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    if (cc != GGML_CUDA_CC_VOLTA || up->op != GGML_OP_MUL_MAT) {
+        return false;
+    }
+    switch (up->src[0]->type) {
+        case GGML_TYPE_IQ3_S: case GGML_TYPE_IQ3_XXS: case GGML_TYPE_IQ2_S: case GGML_TYPE_IQ2_XS: case GGML_TYPE_IQ2_XXS:
+            return true;
+        default:
+            return false;
+    }
